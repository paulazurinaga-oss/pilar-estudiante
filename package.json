{
  "name": "pilar-del-estudiante",
  "version": "1.0.0",
  "description": "PILAR del estudiante app for study, transcription and IA workflow",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "serve": "node server.js",
    "migrate:render-firebase": "node tools/migrate-render-storage-to-firebase.js",
    "desktop": "electron .",
    "test": "node --test",
    "license:init": "node tools/init-license-issuer.js",
    "license:issue": "node tools/generate-signed-license.js",
    "build": "electron-builder --win",
    "electron:build": "npm run build",
    "package:win": "npm run build",
    "package:portable": "npx --yes node@22 node_modules/electron-packager/bin/electron-packager.js . PILAR --platform=win32 --arch=x64 --out=dist-portable --overwrite --asar --extra-resource=node_modules/ffmpeg-static/ffmpeg.exe --icon=icon.ico --ignore=^/storage --ignore=^/dist-pilar- --ignore=^/\\.env$"
  },
  "keywords": [
    "study",
    "transcription",
    "ai",
    "workspace"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22 <25"
  },
  "devDependencies": {
    "electron": "^31.7.4",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.5.0"
  },
  "overrides": {
    "firebase-admin": {
      "rimraf": "^6.1.4"
    }
  },
  "build": {
    "appId": "com.pilar.delestudiante",
    "productName": "PILAR del estudiante",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!dist-installer/**",
      "!dist-installer-verified/**",
      "!dist-installer-sale/**",
      "!dist-portable/**",
      "!storage/**",
      "!**/.env",
      "!**/.env.*",
      "!**/*.backup",
      "!**/test/**",
      "!**/tools/**",
      "PRIVACIDAD.md",
      "CONDICIONES-DE-USO.md",
      "PRELANZAMIENTO-COMERCIAL.md"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PILAR del estudiante"
    }
  }
}
