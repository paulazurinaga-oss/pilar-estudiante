{
  "name": "pilar-del-estudiante",
  "version": "1.0.0",
  "description": "PILAR del estudiante app for study, transcription and IA workflow",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "serve": "node server.js",
    "desktop": "electron .",
    "test": "node -e \"console.log('No automated tests configured yet.')\"",
    "package:win": "npx --yes node@22 node_modules/electron-packager/bin/electron-packager.js . PILAR --platform=win32 --arch=x64 --out=dist --overwrite --icon=icon.ico --ignore=^/storage --ignore=^/dist-pilar- --ignore=^/\\.env$"
  },
  "keywords": [
    "study",
    "transcription",
    "ai",
    "workspace"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^31.7.4",
    "electron-packager": "^17.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0"
  }
}
